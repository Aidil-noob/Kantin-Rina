# Domain yang A record-nya sudah diarahkan ke IP VPS.
# Untuk uji lokal dengan Docker, bisa diisi localhost (akses via https tetap butuh domain).
DOMAIN=kasir.example.com

# Wajib di produksi. Buat dengan:
#   node scripts/hash-password.js 'password-kuat'
# Untuk Docker Compose, bungkus dengan kutip tunggal agar karakter $ aman:
#   ADMIN_PASSWORD_HASH='scrypt$16384$...'
ADMIN_PASSWORD_HASH=

# Wajib. Buat dengan:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Masa berlaku sesi dalam jam. 168 = 7 hari (nyaman untuk layar antrean).
SESSION_TTL_HOURS=168

# Jumlah reverse proxy tepercaya di depan aplikasi (Caddy = 1).
TRUST_PROXY=1
